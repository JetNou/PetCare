# =========================
# PostgreSQL
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379
REDIS_TTL=600

# =========================
# CORS и безопасность
# =========================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://yourdomain.com
SECRET_KEY=long_secret_key_for_jwt_token_generation
ALGORITHM=HS256
PASSWORD_PEPPER=long_random_pepper_for_password_hashing
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# =========================
# Загрузка файлов
# =========================
UPLOAD_DIR=./backend/uploads
AVATAR_DIR=./backend/uploads/avatars

# =========================
# Администратор
# =========================
ADMIN_IMAGES=avatars/user-1-admin.jpg
ADMIN_PASSWORD=long_admin_password
ADMIN_EMAIL=admin@example.com

# =========================
# Cookie и сессии
# =========================
COOKIE_MODE=true  # true если использовать httpOnly cookies для токенов

# =========================
# URLs приложения
# =========================
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000/api/v1

# =========================
# SMTP / почта
# =========================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USER=email@domain.com
SMTP_PASSWORD=XXXXXXXXXXXXXXXX
SMTP_FROM=email@domain.com

# =========================
# Токены и верификация
# =========================
TOKEN_TTL_SECONDS=86400
TOKEN_RESEND_MAX=5
TOKEN_RESEND_WINDOW_SECONDS=86400
RESET_PASSWORD_TTL_SECONDS=3600
DELETE_USER_TTL_SECONDS=604800
VERIFICATION_TTL_SECONDS=86400

# =========================
# Кэш изображений
# =========================
IMAGE_CACHE_TTL=3600
IMAGE_CACHE_MAX_BYTES=500000
